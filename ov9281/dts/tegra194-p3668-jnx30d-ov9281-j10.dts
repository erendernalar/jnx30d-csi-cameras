// SPDX-License-Identifier: GPL-2.0-only
/*
 * Arducam UC-788 Rev.B (OV9281, Raspberry-Pi 15-pin format, no Jetvariety MCU)
 * on Auvidea JNX30D connector J10 (CSI-2 A, 2 lanes) with Jetson Xavier NX,
 * L4T R35.6.x. Driver: nv_ov9281 (compatible "ovti,ov9281").
 *
 * Base DTB requirement: NVIDIA p3509-style Xavier NX DTB built with symbols
 * (-@), exposing these labels: cam_i2c, tegra_main_gpio, bpmp, tcp,
 * cam_module0, cam_module0_drivernode0, cam_module1, imx219_cam0, imx219_cam1,
 * rbpcv2_imx219_{vi_in0,csi_in0,csi_out0,vi_in1,csi_in1,csi_out1}.
 * scripts/40-deploy-dt.sh verifies this on the target before merging.
 *
 * Hardware facts used (JNX30D manual v1.7, sec. 5.7 / 5.4 / App. C):
 *   J10 pins 14/15 = CSI_A_CLK, 17/18 = CSI_A_D1, 20/21 = CSI_A_D0
 *       -> NVCSI brick A, port-index 0, "serial_a", 2 lanes
 *   J10 pins 2/3   = CAM_I2C (module 213/215) -> /i2c@3180000 = i2c-2, 3.3 V
 *   J10 pin 6      = camera power enable (Pi pin 11), follows module pin 206
 *                    (GPIO07 / soc_gpio44_pr0 = TEGRA194_MAIN_GPIO(R,0) = 136)
 *       -> MEASURED on a JNX30D: PR.00 HIGH => camera ON. The manual describes
 *          an inverter (LOW = on); that did not hold on our board.
 *
 * Literal constants (from R35.6.4 dt-bindings):
 *   TEGRA194_CLK_EXTPERIPH1 = 36, TEGRA194_MAIN_GPIO(R,0) = 17*8+0 = 136
 *
 * Build:  dtc -@ -I dts -O dtb -o ov9281-j10.dtbo tegra194-p3668-jnx30d-ov9281-j10.dts
 */

/dts-v1/;
/plugin/;

/ {
	overlay-name = "JNX30D J10 OV9281 (UC-788)";
	compatible = "nvidia,p3509-0000+p3668-0000", "nvidia,p3509-0000+p3668-0001",
		     "nvidia,p3449-0000+p3668-0000", "nvidia,p3449-0000+p3668-0001";

	/* 1. Camera power enable as a GPIO regulator (active-HIGH at the SoC,
	 *    measured; manual claims an inverter). The regulator core owns the line;
	 *    requesting it switches the pad from PWM8 to GPIO and un-tristates
	 *    it (pinctrl-tegra gpio_request_enable / gpio_set_direction).
	 *    enable-active-high => enabled == physical HIGH (measured).     */
	fragment@0 {
		target-path = "/";
		__overlay__ {
			ov9281_cam_en: regulator-ov9281-cam-en {
				compatible = "regulator-fixed";
				regulator-name = "ov9281-cam-en";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				/* MEASURED 2026-10-19 with OV5647 on this board: PR.00 HIGH = camera ON */
				gpio = <&tegra_main_gpio 136 0>;
				enable-active-high;
				startup-delay-us = <20000>;
			};
		};
	};

	/* 2. The JNX30D has no dev-kit I2C mux: each connector has its own bus.
	 *    Disable the dev-kit mux (stops it toggling AON GPIO CC.03) and the
	 *    stock IMX219 nodes behind it.                                    */
	fragment@1 {
		target-path = "/cam_i2cmux";
		__overlay__ {
			status = "disabled";
		};
	};
	fragment@2 {
		target = <&imx219_cam0>;
		__overlay__ {
			status = "disabled";
		};
	};
	fragment@3 {
		target = <&imx219_cam1>;
		__overlay__ {
			status = "disabled";
		};
	};

	/* 3. Sensor directly on CAM_I2C (i2c-2), address 0x60 (SID low). */
	fragment@4 {
		target = <&cam_i2c>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			ov9281_a@60 {
				compatible = "ovti,ov9281";
				reg = <0x60>;
				devnode = "video0";

				/* nv_ov9281 requires an mclk; the UC-788 has its own
				 * oscillator and J10 carries no MCLK, so this clock only
				 * satisfies the driver (same form as T194 imx185 DT). */
				clocks = <&bpmp 36>, <&bpmp 36>;
				clock-names = "extperiph1", "pllp_grtba";
				mclk = "extperiph1";

				/* camera enable (J10 pin 6) via regulator above */
				avdd-reg = "vana";
				vana-supply = <&ov9281_cam_en>;

				physical_w = "3.840";
				physical_h = "2.400";
				sensor_model = "ov9281";
				use_sensor_mode_id = "true";

				/* 1280x800 RAW10, 2-lane, continuous clock (0x4800=0x00).
				 * Timing: sensor HTS reg 728 (counts 2-px units) = 1456 px
				 * line, VTS 1820,
				 * 160 MHz pixel rate from a 24 MHz input => ~60.4 fps,
				 * 400 MHz MIPI link. R35 has no mono path, so the
				 * sensor is exposed as BGGR10 (driver default fmt). */
				mode0 {
					mclk_khz = "24000";
					num_lanes = "2";
					tegra_sinterface = "serial_a";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";

					active_w = "1280";
					active_h = "800";
					mode_type = "bayer";
					pixel_phase = "bggr";
					csi_pixel_bit_depth = "10";
					readout_orientation = "0";
					line_length = "1456";
					inherent_gain = "1";
					mclk_multiplier = "6.67";
					pix_clk_hz = "160000000";

					gain_factor = "16";
					framerate_factor = "1000000";
					exposure_factor = "1000000";
					min_gain_val = "16";
					max_gain_val = "248";
					step_gain_val = "1";
					default_gain = "16";
					min_hdr_ratio = "1";
					max_hdr_ratio = "1";
					min_framerate = "2000000";
					max_framerate = "60000000";
					step_framerate = "1";
					default_framerate = "60000000";
					min_exp_time = "10";
					max_exp_time = "16500";
					step_exp_time = "1";
					default_exp_time = "6200";
					embedded_metadata_height = "0";
				};

				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						ov9281_out0: endpoint {
							status = "okay";
							port-index = <0>;
							bus-width = <2>;
							remote-endpoint = <&rbpcv2_imx219_csi_in0>;
						};
					};
				};
			};
		};
	};

	/* 4. Graph channel 0: sensor -> NVCSI ch0 (brick A) -> VI port0. */
	fragment@5 {
		target = <&rbpcv2_imx219_csi_in0>;
		__overlay__ {
			status = "okay";
			port-index = <0>;
			bus-width = <2>;
			remote-endpoint = <&ov9281_out0>;
		};
	};
	fragment@6 {
		target = <&rbpcv2_imx219_csi_out0>;
		__overlay__ {
			status = "okay";
		};
	};
	fragment@7 {
		target = <&rbpcv2_imx219_vi_in0>;
		__overlay__ {
			status = "okay";
			port-index = <0>;
			bus-width = <2>;
		};
	};

	/* 5. Graph channel 1 unused: disable so VI does not wait on it. */
	fragment@8 {
		target = <&rbpcv2_imx219_vi_in1>;
		__overlay__ {
			status = "disabled";
		};
	};
	fragment@9 {
		target = <&rbpcv2_imx219_csi_in1>;
		__overlay__ {
			status = "disabled";
		};
	};
	fragment@10 {
		target = <&rbpcv2_imx219_csi_out1>;
		__overlay__ {
			status = "disabled";
		};
	};

	/* 6. Camera platform (used by Argus; V4L2 capture does not need it). */
	fragment@11 {
		target = <&tcp>;
		__overlay__ {
			num_csi_lanes = <2>;
			max_lane_speed = <1500000>;
			min_bits_per_pixel = <10>;
		};
	};
	fragment@12 {
		target = <&cam_module0>;
		__overlay__ {
			status = "okay";
			badge = "jnx30d_front_ov9281";
			position = "front";
			orientation = "1";
		};
	};
	fragment@13 {
		target = <&cam_module0_drivernode0>;
		__overlay__ {
			status = "okay";
			pcl_id = "v4l2_sensor";
			devname = "ov9281 2-0060";
			proc-device-tree = "/proc/device-tree/i2c@3180000/ov9281_a@60";
		};
	};
	fragment@14 {
		target = <&cam_module1>;
		__overlay__ {
			status = "disabled";
		};
	};
};
